+#ifdef __WXGTK3__
+double wxGTKGetDIPScaleFactor()
+{
+    static double s_factor = 0;
+    if ( s_factor > 0 )
+        return s_factor;
+
+    // Allow overriding the factor, e.g. WXGTK_DIP_SCALE=1 restores the old
+    // behaviour of not scaling DIPs at all.
+    wxString env;
+    double value;
+    if ( wxGetEnv("WXGTK_DIP_SCALE", &env) && env.ToCDouble(&value) && value > 0 )
+    {
+        s_factor = value;
+        return s_factor;
+    }
+
+    GdkScreen* screen = gdk_screen_get_default();
+    if ( !screen )
+        return 1; // GTK not initialized yet, don't cache
+
+    double factor = 1;
+    const double res = gdk_screen_get_resolution(screen);
+    if ( res > 0 )
+        factor = wxClip(res / 96.0, 1.0, 4.0);
+
+    s_factor = factor;
+    return s_factor;
+}
+#endif // __WXGTK3__
